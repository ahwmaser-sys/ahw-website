# Copy this file to .env for local dev, or enter each value directly in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit a real .env file (already gitignored).

# ── Database (required) ──
# Local dev: run `corepack pnpm exec prisma dev -d` from apps/public-site
# and use the connection string it prints.
# Production: your real Postgres connection string (see the deployment
# guide for recommended providers), then run
# `corepack pnpm exec prisma migrate deploy` once before first launch.
DATABASE_URL=
# Dev-only, used by `prisma migrate dev` — not needed in production.
SHADOW_DATABASE_URL=

# ── Email — Resend (required for Contact/Careers forms + portal emails) ──
RESEND_API_KEY=

# ── This app's own public URL (required) ──
# Used for OAuth redirect URIs (must exactly match what's registered with
# each platform's developer app) and as an infra-level fallback. Does NOT
# control the site's own links/canonical URLs/SEO — that's the Website
# Domain field in Admin → Brand Kit, editable without a redeploy.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Google Analytics 4 (optional) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Client Portal / Admin Panel (required) ──
# Master switch for the Client Portal. false => /client shows "Coming
# Soon". /admin is unaffected (SUPER_ADMIN can always reach it). This is
# only the pre-seed fallback — Admin → Settings → Client Portal is the
# real, live toggle once the app has run once.
PORTAL_ENABLED=false

# Seeds exactly one SUPER_ADMIN account the first time
# `prisma db seed` runs. Change this password after first login from
# Admin → Settings → Security.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Session cookie signing (required) — generate a real random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# AES-256-GCM key (32 raw bytes, base64) encrypting every Settings →
# Integrations credential at rest (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# ── Media storage (required in production — see the deployment guide) ──
# Vercel Blob read/write token. Provision a Blob store from the Vercel
# dashboard (Storage tab) and connect it to this project — Vercel then
# sets this automatically. Without it, uploads fall back to the local
# filesystem, which does NOT work on Vercel's serverless runtime.
BLOB_READ_WRITE_TOKEN=

# ── Social publishing OAuth apps (optional, one-time infra setup) ──
# Absent = that platform's Connect button in Settings → Integrations
# shows "not configured" and every post stays in Manual mode. Instagram
# and Facebook share one Meta app.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Marketing Ads Control Center (optional, one-time infra setup) ──
# Absent = that platform's Connect button on Admin → Ads shows "not
# configured." Google Ads and Meta Ads reuse the OAuth apps above
# (GOOGLE_CLIENT_ID/SECRET, META_APP_ID/SECRET) with additional ads
# scopes — no second app registration needed for those two. LinkedIn Ads
# reuses LINKEDIN_CLIENT_ID/SECRET the same way, but additionally
# requires that app to be approved into LinkedIn's Marketing Developer
# Platform program (separate approval from basic Sign In). TikTok has no
# existing OAuth app in this codebase, so it needs its own pair. See the
# Marketing Ads Control Center manual for full setup steps per platform.
#
# Google Ads' developer token is issued by a Google Ads manager (MCC)
# account, not Google Cloud — Tools & Settings → API Center in Google
# Ads. Google's automatic review assigns a newly-issued token either
# Explorer access (production calls, some restrictions) or Test account
# access (Google Ads test accounts only) — Basic/Standard access (fewer
# restrictions, needed for real production volume) requires a separate
# application from the same API Center page.
GOOGLE_ADS_DEVELOPER_TOKEN=
# The Customer ID and (if applicable) manager/MCC login-customer-id are
# NOT environment variables — they're collected once per connection via
# the Admin → Ads → Google Ads "Finish setup" form after OAuth, and
# stored encrypted in the database alongside the refresh token, the same
# way every other social/ads platform's per-connection details are.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
