{
  "name": "@agp/public-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && pnpm --filter @agp/api-client --filter @agp/application --filter @agp/domain --filter @agp/design-tokens --filter @agp/ui-components run build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agp/api-client": "workspace:*",
    "@agp/application": "workspace:*",
    "@agp/design-tokens": "workspace:*",
    "@agp/ui-components": "workspace:*",
    "@anthropic-ai/sdk": "^0.115.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tiptap/extension-image": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.45.1",
    "file-type": "^22.0.1",
    "framer-motion": "^12.43.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.1"
  },
  "browserslist": [
    "chrome >= 96",
    "edge >= 96",
    "firefox >= 96",
    "safari >= 15.4",
    "not dead"
  ]
}
