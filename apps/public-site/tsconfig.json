{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noPropertyAccessFromIndexSignature": false,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    // Named explicitly rather than widening to "**/*.js": this is the
    // next/image loader (next.config.js points at it by path, so it
    // cannot be TypeScript) and it has a test that imports it.
    "image-loader.js"
  ],
  "exclude": ["node_modules", "prisma/seed.ts", "scripts/**/*.ts"],
  "references": [
    { "path": "../../packages/api-client" },
    { "path": "../../packages/design-tokens" },
    { "path": "../../packages/ui-components" }
  ]
}
